# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# Browser / Playwright
# ============================================================
HEADLESS=true
BROWSER_TIMEOUT=30000
CAPTCHA_MAX_RETRIES=3

# Remote browser (Browserless.io).
# Leave EMPTY for local dev -> launches a local Chromium.
# Set this on Vercel/serverless -> connects to the remote browser instead.
# Get the endpoint + token from https://www.browserless.io dashboard.
# Example: wss://production-sfo.browserless.io?token=YOUR_BROWSERLESS_TOKEN
BROWSERLESS_WS_ENDPOINT=

# If set, only this captcha solver is used (no fallback chain).
# Leave empty to try all configured solvers in order: azapi -> twocaptcha -> openai.
# Valid values: azapi | twocaptcha | openai
CAPTCHA_SOLVER=

# ============================================================
# Captcha Solver #1 — AZAPI.ai
# Docs: https://documenter.getpostman.com/view/32894641/2sAXxY59U3
# ============================================================
AZAPI_API_KEY=your-azapi-key-here
AZAPI_ENDPOINT=https://api.azapi.ai/t0001c

# ============================================================
# Captcha Solver #2 — 2captcha.com  (fallback)
# Docs: https://2captcha.com/lang/python
# Install: pip install 2captcha-python
# ============================================================
TWOCAPTCHA_API_KEY=your-2captcha-key-here

# ============================================================
# Captcha Solver #3 — OpenAI GPT-4o vision  (fallback)
# Install: pip install openai
# ============================================================
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o

# ============================================================
# Watchlist (MongoDB) — POST /api/track + GET /api/cron/check
# ============================================================
# Mongo connection string. Include the DB name in the URI, e.g.
# mongodb+srv://user:pass@cluster.mongodb.net/visa_tracker?retryWrites=true&w=majority
MONGODB_URI=

# Shared secret the cron endpoint requires as `Authorization: Bearer <CRON_SECRET>`.
# On Vercel this is set automatically for cron invocations — set it in the
# dashboard and Vercel injects the matching header. For local testing, set any
# value and pass it yourself.
CRON_SECRET=

# ============================================================
# Telegram notifications
# ============================================================
# One bot token, two chats: notifications (when a status resolves) and logs
# (one line per check, to confirm the cron is running).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_CHAT_ID=

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
